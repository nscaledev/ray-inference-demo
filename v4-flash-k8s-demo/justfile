# Demo driver for the DeepSeek-V4-Flash Ray Summit talk.
#   just              list recipes
#   just state        what the cluster is running right now
#   just bench-a      measure whichever strategy you just applied (a|b|c|d)
#   just compare      all strategies side by side, each next to its point
#
# Metrics land in metrics/*.json so `just compare` works even after the pods are gone.

export KUBECONFIG := env_var_or_default("KUBECONFIG", justfile_directory() + "/../ray-demo-kubeconfig.yaml")
ns := "v4-flash-demo"
model := "deepseek-ai/DeepSeek-V4-Flash-0731"

# Point BARE kubectl at this demo's kubeconfig.
#
#     eval "$(just enable-kube)"
#
# The recipes in this justfile already export KUBECONFIG themselves (see the top), so this
# is only for typing `kubectl` directly. It PRINTS the export line rather than setting it,
# because a recipe runs in a child process and a child cannot mutate its parent's
# environment -- `just enable-kube` on its own would appear to work and change nothing.
# Only the export line goes to stdout, so the eval stays clean; checks go to stderr.
[doc("Print the export line so bare kubectl uses this cluster — eval \"$(just enable-kube)\"")]
enable-kube:
    #!/usr/bin/env bash
    set -uo pipefail
    cfg="{{ justfile_directory() }}/../ray-demo-kubeconfig.yaml"
    if [ ! -f "$cfg" ]; then
      echo "kubeconfig not found: $cfg" >&2
      exit 1
    fi
    abs="$(cd "$(dirname "$cfg")" && pwd)/$(basename "$cfg")"
    if KUBECONFIG="$abs" kubectl get --raw /readyz >/dev/null 2>&1; then
      ctx=$(KUBECONFIG="$abs" kubectl config current-context 2>/dev/null)
      echo "# cluster answers /readyz · context ${ctx:-?} · namespace {{ ns }}" >&2
    else
      echo "# WARNING: cluster did not answer /readyz with this kubeconfig" >&2
    fi
    echo "export KUBECONFIG=$abs"

default:
    @just --list --unsorted

# --- state ------------------------------------------------------------------

# Cluster, GPUs, Ray, and which model (if any) is being served right now.
[doc("What the cluster is running right now: GPUs, Ray, and which endpoints serve")]
state:
    @echo "=== nodes / GPUs ==="
    @kubectl get nodes -o custom-columns='NAME:.metadata.name,TYPE:.metadata.labels.node\.kubernetes\.io/instance-type,GPU:.status.allocatable.nvidia\.com/gpu'
    @echo
    # Running/Pending ONLY. Filtering on the GPU request alone listed a Completed pod
    # from a two-day-old dcgmi stress Job as still holding 8 GPUs: a finished pod's
    # containers have exited and released their devices. This block is on screen during
    # demo beat 1, where the whole point is saying truthfully what is holding what.
    @echo "=== GPU allocation (who holds them) ==="
    @kubectl get pods -A -o json | python3 -c 'import json,sys; \
      pods=json.load(sys.stdin)["items"]; \
      live=lambda p: p["status"].get("phase") in ("Running","Pending"); \
      rows=[(p["metadata"]["namespace"], p["metadata"]["name"], c["resources"].get("requests",{}).get("nvidia.com/gpu"), p["spec"].get("nodeName") or "-") \
            for p in pods if live(p) for c in p["spec"]["containers"] if c["resources"].get("requests",{}).get("nvidia.com/gpu")]; \
      total=sum(int(g) for _,_,g,_ in rows); \
      print("\n".join(f"  {g}x GPU  {ns}/{n}  on {node}" for ns,n,g,node in rows) or "  none"); \
      print(f"  ---- {total} GPU(s) held")'
    @echo
    @echo "=== RayCluster ==="
    @kubectl -n {{ns}} get raycluster 2>/dev/null || echo "  none"
    @echo
    @echo "=== RayJobs / strategy workloads ==="
    @kubectl -n {{ns}} get rayjob 2>/dev/null | tail -n +1 || true
    @kubectl -n {{ns}} get deploy 2>/dev/null | tail -n +1 || true
    @echo
    @echo "=== weights on the shared PVC ==="
    @kubectl -n {{ns}} get pvc v4-flash-models --no-headers 2>/dev/null || echo "  no PVC"
    @echo
    @echo "=== endpoints actually answering /v1/models ==="
    @-just _models

# Which endpoints are actually answering, probed from INSIDE the cluster.
#
# Probing from a vLLM pod means no tunnels and no guessing: the image ships curl and the pod
# resolves every Service by DNS. If no vLLM pod exists then nothing is serving, and saying so
# is the right answer rather than a fallback.
_endpoints:
    #!/usr/bin/env bash
    set -uo pipefail
    probe=""
    for sel in "ray.io/node-type=head" "app=v4-flash-longctx" "app=v4-flash-tep8" "app=v4-flash-replica"; do
      probe=$(kubectl -n {{ns}} get pods -l "$sel" --field-selector=status.phase=Running \
              -o name 2>/dev/null | head -1 | cut -d/ -f2)
      [ -n "$probe" ] && break
    done
    [ -z "$probe" ] && exit 0
    # EVERY service any strategy can expose. This list is the blast radius of the whole sanity
    # gate: an endpoint missing here is never asked a question, so verify-output would report a
    # clean pre-flight for an engine it never looked at, and exit 0. Add a service to this list
    # in the same change that adds the manifest exposing it, and count the rows in the output.
    for target in v4-flash-tep8:8000 v4-flash-openai:8000 \
                  v4-flash-replicas:8000 v4-flash-longctx:8000; do
      svc=${target%%:*}; port=${target##*:}
      if kubectl -n {{ns}} exec "$probe" -- curl -sf -m 4 \
           "http://$svc:$port/v1/models" >/dev/null 2>&1; then
        echo "$svc $port"
      fi
    done


_models:
    #!/usr/bin/env bash
    set -uo pipefail
    found=$(just _endpoints)
    if [ -z "$found" ]; then
      echo "  nothing is serving"
    else
      echo "$found" | while read -r svc port; do
        echo "  serving: svc/$svc:$port"
      done
    fi

# Is the endpoint answering yet? (see the LIFECYCLE block near _bench for why these
# three recipes are written together)
[doc("Poll an endpoint until it answers /v1/models")]
wait-ready port="8000" svc="v4-flash-openai" budget="540":
    #!/usr/bin/env bash
    set -uo pipefail
    pf=""
    drop_tunnel() { [ -n "${pf:-}" ] && kill "$pf" 2>/dev/null; pf=""; }
    trap drop_tunnel EXIT INT TERM
    echo "waiting for svc/{{svc}} to answer /v1/models (cold start: weights + kernel JIT)"
    for i in $(seq 1 {{budget}}); do
      # INVARIANT 2: re-establish every 60 s. A port-forward opened before the server binds
      # stays alive, refuses everything, and never recovers — that looked exactly like a
      # cold engine for 28 minutes while strategy B was already serving.
      if [ $(( (i - 1) % 12 )) -eq 0 ]; then
        drop_tunnel
        kubectl -n {{ns}} port-forward svc/{{svc}} {{port}}:8000 >/dev/null 2>&1 &
        pf=$!
        sleep 2
      fi
      if curl -sf -m 4 "localhost:{{port}}/v1/models" >/dev/null 2>&1; then
        # /v1/models answers as soon as the port is bound. Autotune and CUDA-graph capture DO
        # finish first (measured: 8m19s of autotune, then "Application startup complete"), but
        # per-shape TileLang JIT does not — vLLM logs "JIT compilation during inference" on the
        # first request of an unseen shape. So prove it can GENERATE before saying ready;
        # otherwise a flow proceeds to measure an engine that is minutes from serving at speed.
        echo "endpoint answering after ~$((i * 5))s; checking it can generate"
        body=$(python3 make_request.py "{{model}}" "ping" 1 "localhost:{{port}}/v1/chat/completions" 0.0)
        if curl -sf -m 120 "localhost:{{port}}/v1/chat/completions" \
             -H 'content-type: application/json' -d "$body" 2>/dev/null | grep -q '"choices"'; then
          echo "ready: generated after ~$((i * 5))s"
          exit 0
        fi
        echo "  ... bound but not generating yet (kernels still compiling)"
      fi
      [ $((i % 24)) -eq 0 ] && echo "  ... $((i * 5))s elapsed: weights, then ~8-12 min DeepGEMM JIT, then ~10 min FlashInfer autotune"
      sleep 5
    done
    echo "NOT READY after $(( {{budget}} * 5 ))s — inspect with: just logs"
    exit 1

# Ray dashboard — placement groups, actors, GPU assignment. Blocks; Ctrl-C to stop.
#
# TAKES A STRATEGY, because there is no longer one dashboard to open. Every strategy is its own
# RayService owning its own RayCluster, so there are as many dashboards as there are strategies
# up -- three during the demo. This recipe used to port-forward a single hardcoded Service, which
# was right when A, B and C were RayJobs sharing one cluster; under RayService it silently showed
# B's dashboard whatever you were talking about. Pointing at eight DP replicas while narrating
# A's tensor-parallel placement group is the kind of wrong that an audience spots.
#
#     just dashboard          # A, the deck's headline shape
#     just dashboard b        # the published reference shape
#     just dashboard 1m       # the long-context engine
#     just dashboard d        # the scale-out fleet, when it is up
[doc("Ray dashboard for one strategy: a|b|1m|d (blocks; Ctrl-C to stop)")]
dashboard strategy="a" port="8265":
    #!/usr/bin/env bash
    set -uo pipefail
    case "{{strategy}}" in
      a|A)        rs=v4-flash-a;         label="A · TP8 + EP" ;;
      b|B)        rs=v4-flash-b;         label="B · DP8 x EP + DSpark" ;;
      b-nospec)   rs=v4-flash-b-nospec;  label="B without DSpark" ;;
      1m|1M)      rs=v4-flash-1m;        label="1M window" ;;
      d|D)        rs=v4-flash-d;         label="D · whole replicas" ;;
      *) echo "unknown strategy '{{strategy}}' — use a, b, b-nospec, 1m or d"; exit 2 ;;
    esac
    # The head Service KubeRay creates is <cluster>-head-svc, and the cluster name carries a
    # generated suffix, so resolve it from the RayService rather than guessing the name.
    cluster=$(kubectl -n {{ns}} get rayservice "$rs" \
                -o jsonpath='{.status.activeServiceStatus.rayClusterName}' 2>/dev/null)
    [ -n "$cluster" ] || cluster=$(kubectl -n {{ns}} get rayservice "$rs" \
                -o jsonpath='{.status.pendingServiceStatus.rayClusterName}' 2>/dev/null)
    [ -n "$cluster" ] || { echo "$rs is not up — nothing to open"; exit 1; }
    echo "Ray dashboard for $label  ($cluster)  -> http://localhost:{{port}}   (Ctrl-C to stop)"
    command -v open >/dev/null && (sleep 2 && open "http://localhost:{{port}}" >/dev/null 2>&1 &) || true
    exec kubectl -n {{ns}} port-forward "svc/${cluster}-head-svc" {{port}}:8265

# Per-GPU utilisation and memory, from inside whichever pod holds the GPUs.
[doc("Per-GPU utilisation and memory, from inside the pods holding them")]
gpus:
    #!/usr/bin/env bash
    set -uo pipefail
    for p in $(kubectl -n {{ns}} get pods -o name | cut -d/ -f2); do
      if kubectl -n {{ns}} get pod "$p" -o jsonpath='{.spec.containers[*].resources.requests.nvidia\.com/gpu}' 2>/dev/null | grep -q '[0-9]'; then
        echo "=== $p ==="
        kubectl -n {{ns}} exec "$p" -- nvidia-smi \
          --query-gpu=index,utilization.gpu,memory.used,memory.total \
          --format=csv,noheader 2>/dev/null || echo "  (nvidia-smi unavailable)"
      fi
    done

# Same, refreshed — this is what makes two P/D pools visible during strategy C.
[doc("Same as gpus, refreshed — shows C's two pools lighting up separately")]
watch-gpus interval="2":
    #!/usr/bin/env bash
    set -uo pipefail
    while true; do clear; date +%T; just gpus; sleep {{interval}}; done

# The raw primitive: ask ANY service. Private on purpose. As a public `just ask` with an empty
# svc it picked the first live endpoint, which during strategy C is the P/D router -- so the
# most convenient command was also the one that returned garbage. Every public ask-* recipe
# names its strategy and refuses unless that strategy is serving.
# (No [doc] attribute: a leading underscore hides it from `just --list` anyway, and an
# attribute must sit IMMEDIATELY above its recipe -- a comment in between orphans it and just
# fails with "Extraneous attribute".)
_ask prompt="One sentence: why keep expert routing on NVLink?" svc="" port="8000" temp="1.0":
    #!/usr/bin/env bash
    set -uo pipefail
    # svc="" means "whatever is serving", discovered rather than hardcoded: a fixed default is
    # wrong whenever the strategy serving on it is not the one that is up.
    svc="{{svc}}"; port="{{port}}"
    if [ -z "$svc" ]; then
      pick=$(just _endpoints | head -1)
      [ -z "$pick" ] && { echo "nothing is serving — bring a strategy up first"; exit 1; }
      svc=${pick%% *}; port=${pick##* }
      echo "(asking svc/$svc:$port)"
    fi
    probe=$(kubectl -n {{ns}} get pods -l ray.io/node-type=head --field-selector=status.phase=Running -o name 2>/dev/null | head -1 | cut -d/ -f2)
    [ -z "$probe" ] && probe=$(kubectl -n {{ns}} get pods -l app=v4-flash-longctx --field-selector=status.phase=Running -o name 2>/dev/null | head -1 | cut -d/ -f2)
    [ -z "$probe" ] && { echo "no vLLM pod to ask from"; exit 1; }
    # make_request.py prints the call on stderr (visible) and the JSON body on stdout.
    # temp defaults to the model card's 1.0 for the live beat; pass 0.0 to use this as a
    # diagnostic (greedy decoding on a model specified for 1.0 tends to read repetitive).
    body=$(python3 make_request.py "{{model}}" "{{prompt}}" 200 "http://$svc:$port/v1/chat/completions" "{{temp}}")
    # -w appends curl's own %{time_total} as a trailing __TIMING__ line, measured INSIDE the
    # pod so it excludes kubectl-exec setup. show_answer.py strips it before parsing the JSON
    # and prints latency + tok/s + token counts on one line. NOT called TTFT: this request is
    # buffered, so first-byte time IS last-token time, and that label would lie.
    kubectl -n {{ns}} exec "$probe" -- curl -s -m 300 "http://$svc:$port/v1/chat/completions" \
      -H 'content-type: application/json' -d "$body" \
      -w '\n__TIMING__ %{time_total}\n' > /tmp/just-ask.json 2>/dev/null
    python3 show_answer.py /tmp/just-ask.json

# Driver log of the running RayJob (strategies A, B and C).
[doc("Follow the running RayJob's driver log")]
logs:
    #!/usr/bin/env bash
    set -uo pipefail
    h=$(kubectl -n {{ns}} get pod -l ray.io/node-type=head -o name | head -1 | cut -d/ -f2)
    kubectl -n {{ns}} exec "$h" -- bash -c 'tail -f $(ls -t /tmp/ray/session_latest/logs/job-driver-*.log | head -1)'


# --- ask one named strategy, and prove it is that strategy -------------------------------
# These guards exist because B and B-DSpark were RayJobs sharing ONE Service
# (v4-flash-openai:8000), so a bare `just ask` could not tell you which of them answered, and an
# `ask-a` that silently answered from B would be a new way to mislead. Each recipe therefore
# refuses unless the strategy it names is the one actually serving.
#
# Under RayService each strategy owns its own cluster and its own Service, so the ambiguity is
# mostly gone -- but the guard is worth more, not less: it now checks a Ready condition derived
# from Serve's health check of the application rather than a RayJob's jobStatus, which only ever
# described the submitter. ask-b-nospec still names a RayJob (20b has no RayService yet) and
# will correctly refuse whenever that engine is not deployed.
_ask-strategy label want svc port prompt temp="1.0" note="":
    #!/usr/bin/env bash
    set -uo pipefail
    case "{{want}}" in
      deploy/*)
        n=$(kubectl -n {{ns}} get {{want}} -o jsonpath='{.status.readyReplicas}' 2>/dev/null || true)
        [ "${n:-0}" -ge 1 ] || { echo "REFUSING: {{label}} is not serving — {{want}} has ${n:-0} ready replicas"; exit 1; } ;;
      rayservice/*)
        # The signal a RayJob could not give us. jobStatus=RUNNING only ever meant "the
        # submitter process is alive" — it reported RUNNING while the engine served garbage.
        # This Ready condition is set from Serve's own health check of the APPLICATION.
        st=$(kubectl -n {{ns}} get {{want}} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)
        [ "$st" = "True" ] || { echo "REFUSING: {{label}} is not serving — {{want}} Ready='${st:-absent}'"; exit 1; } ;;
      *)
        st=$(kubectl -n {{ns}} get rayjob {{want}} -o jsonpath='{.status.jobStatus}' 2>/dev/null || true)
        [ "$st" = "RUNNING" ] || { echo "REFUSING: {{label}} is not serving — rayjob {{want}} is '${st:-absent}'"; exit 1; } ;;
    esac
    echo "──── {{label}} ────"
    # NEVER put a backtick in a note. just interpolates {{note}} into a double-quoted bash
    # string, so a backtick survives as command substitution: a note reading "... is
    # \`just longctx\`" actually RAN just longctx, firing a 996K-token request as a side
    # effect of asking a 19-token question. Write command names bare instead.
    # The note prints BEFORE the request, not after: `just ask` hits the million-token engine
    # with a 74-character prompt, and the room will assume it just watched the million-token
    # test unless told otherwise -- and by the time the answer lands, the moment to say it has
    # passed. Anything that explains what is about to happen has to be on screen first.
    [ -n "{{note}}" ] && echo "     {{note}}"
    [ -n "{{note}}" ] && echo
    just _ask "{{prompt}}" "{{svc}}" "{{port}}" "{{temp}}"

[doc("Ask strategy A and show the exchange (refuses unless A is serving)")]
ask-a prompt="In one sentence: why keep expert routing inside the NVLink domain?" temp="1.0":
    @just _ask-strategy "A · TEP8 (TP8 + EP, RayService)" rayservice/v4-flash-a v4-flash-tep8 8000 "{{prompt}}" "{{temp}}" "strategy A — attention sliced 8 ways, whole experts per GPU. The latency shape."

[doc("Ask strategy B and show the exchange (refuses unless B is serving)")]
ask-b prompt="In one sentence: what does speculative decoding change about decode?" temp="1.0":
    @just _ask-strategy "B · DP8xEP + MegaMoE + DSpark" rayservice/v4-flash-b v4-flash-openai 8000 "{{prompt}}" "{{temp}}" "strategy B — the shape DeepSeek published: data parallel by 8, expert parallel, speculator on."

[doc("Ask B-without-DSpark and show the exchange")]
ask-b-nospec prompt="In one sentence: what is expert parallelism?" temp="1.0":
    @just _ask-strategy "B - DSpark (DP8xEP + MegaMoE)" serve-dp8-ep-nospec v4-flash-openai 8000 "{{prompt}}" "{{temp}}" "strategy B with the speculator removed — the DSpark isolation run."

[doc("Ask strategy D through the replica Service")]
ask-d prompt="In one sentence: what does scaling out with whole replicas buy you?" temp="1.0":
    @just _ask-strategy "D · replicas" deploy/v4-flash-replicas v4-flash-replicas 8000 "{{prompt}}" "{{temp}}" "strategy D — two whole replicas of A behind one Service."

[doc("Ask the 1M-window engine and show the exchange")]
ask prompt="In one sentence: why does a longer context cost cache rather than compute?" temp="1.0":
    @just _ask-strategy "1M window (TP8 + EP, max-model-len 1048576)" rayservice/v4-flash-1m v4-flash-longctx 8000 "{{prompt}}" "{{temp}}" "holds 1,048,576 tokens of context. This is a SHORT prompt, not a million-token one — that test is: just longctx"

[doc("Ask EVERY live endpoint questions with known answers — PASS/FAIL per endpoint")]
verify-output:
    #!/usr/bin/env bash
    set -uo pipefail
    # The anti-lying tool, and it is shown ON STAGE, so it reads for an audience first and an
    # operator second. That means: name the SHAPE of each engine, print the answer it actually
    # gave, and say plainly which are wrong. No internal vocabulary -- an earlier version
    # printed "as scripted — demo beat 4", which means nothing to a room.
    #
    # The operator's pre-flight question ("is the demo still going to work?") is answered by
    # the single line at the bottom and by the exit code, which is the mismatch count. A FAIL
    # that is supposed to happen is not an alarm; a MISMATCH is.
    #
    # strategy|parallelism|part|expected
    #   strategy    the letter from the deck: A, B, D (or 1M for the long-context engine)
    #   parallelism the ONLY thing that differs between these engines -- same weights, same
    #               machine, same image
    #   part        which piece of that strategy this endpoint is
    shape_of() {
      case "$1" in
        v4-flash-longctx:*)   echo "1M|TP8 + EP|whole engine|RIGHT" ;;
        v4-flash-tep8:*)      echo "A|TP8 + EP|whole engine|RIGHT" ;;
        # 21b (B with the speculator off) reuses B's endpoint deliberately, so the address
        # alone cannot say which of the two is live. Ask the cluster. Labelling this row
        # unconditionally would name a strategy that may not be deployed, which on stage reads
        # as an accusation against a shape that is in fact fine.
        v4-flash-openai:*)
          if kubectl -n {{ns}} get rayservice v4-flash-b-nospec >/dev/null 2>&1; then
            echo "B|DP8 x EP, DSpark off|whole engine|RIGHT"
          else
            echo "B|DP8 x EP + DSpark|whole engine|RIGHT"
          fi ;;
        v4-flash-replicas:*)  echo "D|TP8 + EP, x2|both replicas|RIGHT" ;;
        *)                    echo "?|?|unrecognised|?" ;;
      esac
    }
    live=$(just _endpoints)
    [ -n "$live" ] || { echo "nothing is serving"; exit 1; }
    echo
    echo "  Asked every live endpoint the same question, with one known right answer:"
    echo "      \"What is 2+2? Reply with only the number.\"   (temperature 0)"
    echo
    printf "  %-22s %-8s %-19s %-14s %s\n" "endpoint" "strategy" "parallelism" "part" "verdict"
    printf "  %-22s %-8s %-19s %-14s %s\n" "----------------------" "--------" \
           "-------------------" "--------------" "-------"
    mismatch=0; unknown=0; n=0; wrong=0
    while read -r svc port; do
      [ -n "${svc:-}" ] || continue
      ep="$svc:$port"; n=$((n+1))
      out=$(just _ask "What is 2+2? Reply with only the number." "$svc" "$port" 0.0 2>/dev/null \
            | grep -v "^→ POST\|^    model=\|^    prompt\[\|^--" | tr '\n' ' ')
      # STRICT: the reply must BE "4", not merely contain a 4. A substring test passes strings
      # like "## 4660 (almosterCinvasive speciese", so it cannot distinguish a correct answer
      # from garbage that happens to contain the digit.
      norm=$(printf '%s' "$out" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
      if [ "$norm" = "4" ] || [ "$norm" = "four" ] \
         || { [ "${#norm}" -le 6 ] && case "$norm" in *4*) true ;; *) false ;; esac; }; then
        got=RIGHT; mark="✓ correct"
      else
        got=WRONG; mark="✗ WRONG"; wrong=$((wrong+1))
      fi
      info="$(shape_of "$ep")"
      strat="${info%%|*}"; r1="${info#*|}"; par="${r1%%|*}"
      r2="${r1#*|}"; part="${r2%%|*}"; want="${r2#*|}"
      [ "$want" = "?" ] && unknown=$((unknown+1))
      [ "$want" != "?" ] && [ "$got" != "$want" ] && mismatch=$((mismatch+1))
      # The answer gets its own line: it is multi-byte garbage, so printf (which pads by BYTES,
      # not display columns) cannot align anything after it -- and it deserves the width,
      # because the audience is meant to SEE it.
      printf "  %-22s %-8s %-19s %-14s %s\n" "$ep" "$strat" "$par" "$part" "$mark"
      printf "  %-22s   answered: %s\n" "" "$(echo "$out" | cut -c1-70)"
    done < <(echo "$live")
    echo
    # The commentary adapts to what is actually on the table: an explanation of a strategy that
    # is not running is noise in the one output read at T-40, when attention is scarce.
    echo
    if [ "$wrong" -gt 0 ]; then
      echo "  Same weights, same machine, same image -- only the parallelism differs. Every one"
      echo "  of those returned HTTP 200 with zero failed requests. A throughput number cannot"
      echo "  see this. Only reading the answer can."
    else
      echo "  All correct, so every number these engines produce is quotable. Throughput alone"
      echo "  could never have told you that -- only reading an answer can."
    fi
    echo
    if [ "$mismatch" -eq 0 ] && [ "$unknown" -eq 0 ]; then
      echo "  pre-flight: $n/$n endpoints behaved as the runbook expects."
    else
      [ "$mismatch" -gt 0 ] && echo "  pre-flight: ⛔ $mismatch of $n endpoints did NOT behave as expected — read the table."
      [ "$unknown" -gt 0 ]  && echo "  pre-flight: $unknown endpoint(s) unrecognised — add them to shape_of()."
    fi
    exit "$mismatch"

# --- teardown ---------------------------------------------------------------
# 24 GPUs across three machines. A, B and the 1M engine each want 8, which is exactly 24, so all
# three coexist — that is the demo configuration. D wants 16 on its own and therefore cannot
# share with them. The run-* recipes tear down first because they measure one strategy at a
# time; `just stage-up` brings up the three that fit together.

# Remove whatever strategy is serving. Keeps the RayCluster, the PVC and the weights.
# REFUSES if a long-running orchestrator is mid-flight. teardown and demo-e2e.sh both drive
# the same namespace, and running them together produces a state neither intends: prep applies
# the three engines, a manual teardown kills their pods, the surviving Deployments recreate
# replacements, and those sit Pending on GPUs the terminating pods have not released yet. It
# looks like a cluster fault and is just two scripts disagreeing. Same guard as _bench_start.
# Override with FORCE=1 when you know the other process is dead.
[doc("Remove whatever strategy is serving; keep the RayCluster, PVC and weights")]
teardown:
    #!/usr/bin/env bash
    set -uo pipefail
    if [ "${FORCE:-0}" != "1" ]; then
      # Match the INVOCATION, not any command line that mentions the name. `pgrep -fl` on a
      # bare name also matched the shell that was running this very check -- its command line
      # contains the string -- and printed sixty lines of exported environment as "evidence".
      # Anchor on `bash <path>/<script>` and print pid + script only.
      pids=$(pgrep -f '(bash|sh|zsh)? *[^ ]*(demo-e2e|pre-demo)\.sh' 2>/dev/null | grep -vx "$$" || true)
      if [ -n "$pids" ]; then
        echo "REFUSING to tear down: an orchestrator is mid-run and will fight this."
        for pid in $pids; do
          nm=$(ps -o command= -p "$pid" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i ~ /\.sh$/) {print $i; exit}}')
          echo "    pid $pid  ${nm:-unknown}"
        done
        echo "  Let it finish, or:  kill $(echo $pids | tr '\n' ' ') && FORCE=1 just teardown"
        exit 1
      fi
    fi
    just _teardown-now

# Each RayService owns its own RayCluster, so deleting the RayService frees everything it held.
# The Services declared alongside them go too, which is why the endpoint names disappear from
# `just state` rather than lingering as addresses that resolve but refuse connections.
_teardown-now:
    -@kubectl -n {{ns}} delete rayservice --all --ignore-not-found 2>/dev/null
    -@kubectl -n {{ns}} delete svc v4-flash-tep8 v4-flash-openai v4-flash-longctx --ignore-not-found 2>/dev/null
    -@kubectl -n {{ns}} delete svc v4-flash-replicas --ignore-not-found 2>/dev/null
    @just _wait-gpus-free "0"

# Kept as an alias: nothing holds GPUs outside the strategies any more, so there is no separate
# shared RayCluster to drop. Recipes and docs that still say teardown-cluster keep working.
[doc("Alias for teardown — no shared RayCluster exists to drop separately")]
teardown-cluster: teardown

# Wait until at most `keep` GPU-holding pods remain in the namespace. Each strategy now owns its
# own RayCluster, so deleting a RayService releases the whole engine — there is no shared head
# whose previous engine can still be holding devices while the next one starts.
_wait-gpus-free keep:
    #!/usr/bin/env bash
    set -uo pipefail
    jp='{range .items[*]}{.spec.containers[*].resources.requests.nvidia\.com/gpu}{"\n"}{end}'
    for i in $(seq 1 60); do
      n=$(kubectl -n {{ns}} get pods --field-selector=status.phase!=Succeeded -o jsonpath="$jp" 2>/dev/null | grep -c '[0-9]' || true)
      if [ "${n:-0}" -le {{keep}} ]; then echo "GPU-holding pods: ${n:-0} (<= {{keep}})"; exit 0; fi
      sleep 5
    done
    echo "warning: GPU pods still present after 5 min"; kubectl -n {{ns}} get pods

# --- per-strategy run + measurement ----------------------------------------
# run-* = teardown, apply the manifest, wait for the engine, measure, keep it up.
# Cold start is minutes (weight load + kernel JIT); the JIT cache hostPaths in 03/30/40
# make later starts much cheaper.
#
# ONE MEASUREMENT METHOD FOR ALL FOUR STRATEGIES: a Job inside the cluster, hitting the
# strategy's Service by DNS. Two reasons, and it is worth being precise about which:
#   1. `kubectl port-forward svc/...` pins to ONE pod, so it cannot measure a
#      multi-replica Service at all. That alone settles the method question.
#   2. Same method everywhere is the only way `just compare`'s columns mean anything.
# What in-cluster did NOT fix: D's 424 tok/s / 36 s TTFT p95. An in-cluster run through
# the Service reported 426.4 / 35.7 s — the same number, so the tunnel was never the cause
# (see metrics/_archive-incluster-chunkcount-D-replicas.json).
#
# Warming every endpoint did not fix it either. That was the second wrong diagnosis, and
# repeat-tour proved it: D still spanned 218 - 4417 tok/s (20x) with warmup in place. The
# measured cause, found by benching each pod DIRECTLY instead of through the Service:
#   pod A alone, concurrency 32 ->  190.8 tok/s, TTFT p95 40.3 s
#   pod B alone, concurrency 32 -> 2097.9 tok/s, TTFT p95  1.2 s
# Same image, same manifest, same node type, 8 h uptime each. One replica was serving ~11x
# slower than the other, and its log showed TileLang kernel compiles timestamped INSIDE the
# benchmark window (17 compiles total; the healthy pod logged 0). So a replica can pass
# /health, serve a warmup, and still JIT-compile a new kernel shape under load — and the
# mounted per-node cache never receives those kernels (`find /root/.tilelang -name
# "*mhc_pre_big*"` returns 0 on both pods), so the compile can recur.
#
# The lesson for the harness, not just for D: a Service-level number cannot tell you that
# one backend is sick. Measure each replica alone before believing a fleet aggregate.
# D's aggregate is therefore NOT quotable until every replica measures the same alone.

[doc("A · TEP8: teardown, apply, wait, measure, leave it serving")]
run-a: teardown && bench-a
    kubectl apply -f 11-strategy-tep8-rayservice.yaml
    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-a --timeout=45m

[doc("B · DP8xEP + MegaMoE + DSpark, the published reference shape")]
run-b: teardown && bench-b
    kubectl apply -f 21-strategy-dp8-ep-rayservice.yaml
    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-b --timeout=45m

[doc("1M window · the same engine as A with the context opened to 1,048,576")]
run-1m: teardown
    kubectl apply -f 51-longctx-1m-rayservice.yaml
    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-1m --timeout=45m

# NOTE: a [doc] attribute must sit IMMEDIATELY above its recipe; comments in between orphan it
# and just errors with "Extraneous attribute".
[doc("D · whole replicas across machines behind one Service")]
run-d: teardown && bench-d
    kubectl apply -f 41-strategy-replicas-rayservice.yaml

# The whole tour, in talk order, ending in the comparison table.
# Separate `just` invocations on purpose: within ONE invocation just runs each recipe at
# most once, so `run-all: run-a run-b run-d` would fire `teardown` only before A — B and D
# would then measure whatever was still serving, silently, under the wrong label.
[doc("The whole tour in talk order, ending in compare")]
run-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for s in a b d; do
      echo; echo "######## strategy ${s} ########"
      just "run-${s}"
    done
    just compare

# --- measurement only (strategy already applied) ----------------------------

# A · TEP8 — the latency shape.
[doc("Measure A (assumes it is already serving)")]
bench-a: (_bench "A-tep8" "TEP8 (RayService)" "latency shape: attention sliced 8 ways inside the NVLink domain, whole experts per GPU" "v4-flash-tep8" "32")

# B · DP8 x EP (+ MegaMoE, + DSpark) — the published reference shape.
[doc("Measure B")]
bench-b: (_bench "B-dp8-ep" "DP8xEP + MegaMoE + DSpark" "the published reference config, widened from DP4/4xGB300" "v4-flash-openai" "32")

# B without DSpark — isolates the speculator's cost on the same harness.
[doc("Measure B without DSpark")]
bench-b-nospec: (_bench "B-dp8-ep-nospec" "DP8xEP, DSpark off" "isolates DSpark: identical to B with speculative_config removed" "v4-flash-openai" "32")

[doc("B with speculative_config removed, to isolate DSpark")]
run-b-nospec: teardown && bench-b-nospec
