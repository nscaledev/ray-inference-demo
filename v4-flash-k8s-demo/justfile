    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-b-nospec --timeout=45m

# D · whole replicas across machines. Offered load scales with the fleet: 32 per replica.
# At a fixed 32 total, two replicas get 16 each, neither fills a batch, and aggregate comes
# out flat vs one machine — which reads as "scale-out does nothing". It isn't; scale-out
# buys capacity at a given latency, so the load has to grow with it.
[doc("Measure D, scaling offered load to 32 requests per replica")]
bench-d:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "waiting for the D RayService (cold engine start is ~20 min)"
    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-d --timeout=45m || exit 1
    # The replica count comes from SERVE, not from counting pods: num_replicas is the thing that
    # defines the strategy, and a worker pod that is Running but whose replica failed to start
    # would otherwise inflate the offered load and depress the per-replica number.
    h=$(kubectl -n {{ns}} get pods -l ray.io/node-type=head --field-selector=status.phase=Running -o name 2>/dev/null | grep v4-flash-d | head -1 | cut -d/ -f2)
    n=$(kubectl -n {{ns}} exec "$h" -- bash -lc "curl -s localhost:8265/api/serve/applications/ | python3 -c \"import json,sys; d=json.load(sys.stdin); print(sum(len(dep.get('replicas') or []) or (dep.get('deployment_config') or {}).get('num_replicas') or 0 for app in (d.get('applications') or {}).values() for name,dep in (app.get('deployments') or {}).items() if 'LLMServer' in name))\"" 2>/dev/null | tr -d ' \r')
    case "${n:-0}" in ''|*[!0-9]*) n=0 ;; esac
    [ "$n" -gt 0 ] || { echo "Serve reports no LLMServer replicas — is 41-strategy-replicas-rayservice.yaml applied?"; exit 1; }
    echo "replicas: $n -> offering 32 requests per replica ($((32 * n)) total)"
    just _bench "D-replicas" "${n}x 8xB200 replicas (RayService, TP8 each)" "capacity scales per machine; Serve routes across replicas" "v4-flash-replicas" "$((32 * n))"

# Kill one replica mid-load — the strategy D failure demo, measured.
# --runs 0 skips the single-stream pass so the kill lands inside the loaded pass; with it
# enabled a fixed sleep fired during single-stream and the loaded pass then started against
# an already-dead replica, which measures "requests sent to a corpse", not in-flight loss.
# ============================ LIFECYCLE ======================================
# wait-ready and _bench_finish were each patched three times in isolation, and
# twice a fix introduced the next defect in the same lines: fixing a readiness gap added a
# selector race, fixing a too-early kill produced a too-late one, fixing a wedged tunnel
# dropped its cleanup trap. They share one control flow, so they are written together:
#
#   wait-ready    is the endpoint answering?        tunnel, re-established, always cleaned
#   _bench_start  launch the Job, return at once    template only, never waits
#   _job-wait     block until Complete|Failed|out   loud in all three cases
#   _bench_finish _job-wait, then log -> JSON       writes only after a real Complete
#
# INVARIANTS:
#   1. every port-forward dies on every exit path, including failure and Ctrl-C
#   2. a wedged tunnel must never be mistaken for a cold engine
#   3. no wait ends silently — Complete, Failed and timeout all print and set exit status
#   4. nothing writes metrics/*.json unless the Job actually reached Complete
#   5. a fleet aggregate is not believed until each backend has been measured ALONE
#   6. one bench Job at a time — a second must refuse, never take over the name
# =============================================================================

# INVARIANT 5. Measure every replica on its own, bypassing the Service.
#
# This exists because a Service-level number cannot tell you one backend is cold, and that
# cost THREE wrong diagnoses of strategy D — the port-forward, then "cold kernels" in
# general, then "one pod is permanently sick". What the fleet reported as "D is bimodal,
# 218-4417 tok/s" was one pod serving ~11x slower than its twin on an identical manifest:
#     pod A  190.8 tok/s  TTFT p95 40.3s
#     pod B 2097.9 tok/s  TTFT p95  1.2s
# The third diagnosis died when the slow side MOVED after a restart — the replacement was
# fast and the 8-hour-old pod was suddenly slow. Replacing a pod is therefore the wrong
# reflex. The real cost is per-pod, per-request-shape and recurs after idle; bench.py's
# warmup now fires the measured shape (not 64-token stand-ins), after which six consecutive
# passes across both pods held 2046-2493 tok/s, a 1.22x spread.
#
# Run this after benching D and before quoting the number. If the two replicas disagree by more
# than ~1.5x, or one reports nothing, the fleet aggregate is noise: warm them and measure again
# rather than deleting anything.
#
# UNDER A RAYSERVICE, REPLICAS ARE NOT SEPARATELY ADDRESSABLE -- Serve's router decides which one
# gets a request, so the old approach (port-forward to a pod and drive it directly) cannot
# isolate them.
#
# THIS MEASURES GPU BUSYNESS UNDER LOAD, per worker pod. Two log-based approaches were tried and
# both reported nothing on this stack: vLLM's periodic "Avg generation throughput" lines are not
# emitted here, and Serve's replica records carry identity but no request counters. A check that
# silently finds nothing is worse than no check -- it reported "a replica logged NO generation"
# after six passes of 64-concurrent load, which was a defect in the check, not in the fleet.
# Utilisation is physical evidence and does not depend on a log format staying still.
[doc("Check each D replica pulled its weight — a fleet aggregate hides a cold replica")]
probe-d max_samples="60":
    #!/usr/bin/env bash
    set -uo pipefail
    pods=$(kubectl -n {{ns}} get pods --no-headers 2>/dev/null \
           | awk '/^v4-flash-d-.*gpu8-worker/ && $3=="Running" {print $1}')
    [ -n "$pods" ] || { echo "no running D worker pods — is 41-strategy-replicas-rayservice.yaml applied?"; exit 1; }
    n=$(echo "$pods" | grep -c .)
    echo "  driving load through svc/v4-flash-replicas and sampling GPU utilisation per replica"
    # runs 0 = skip the single-stream pass, so the whole window is loaded traffic.
    just _bench_start "_probe-d" "probe" "is every replica actually serving?" \
         "v4-flash-replicas" "$((32 * n))" "0" "256" >/dev/null 2>&1
    for p in $pods; do echo "0 0" > "/tmp/.probe-$p"; done
    # SAMPLE WHILE THE JOB IS ACTIVE, not on a fixed schedule. The loaded pass takes ~13s here;
    # a fixed 40s window averaged mostly-idle samples and reported 0% for both replicas, which
    # reads as "the fleet is dead" when it only means "the bench finished before I looked".
    sleep 3
    for i in $(seq 1 {{max_samples}}); do
      for p in $pods; do
        u=$(kubectl -n {{ns}} exec "$p" -- nvidia-smi --query-gpu=utilization.gpu \
              --format=csv,noheader,nounits 2>/dev/null | awk '{s+=$1; c++} END {if(c) printf "%.0f", s/c; else print 0}')
        read -r sum cnt < "/tmp/.probe-$p"
        echo "$((sum + ${u:-0})) $((cnt + 1))" > "/tmp/.probe-$p"
      done
      active=$(kubectl -n {{ns}} get job bench-in-cluster -o jsonpath='{.status.active}' 2>/dev/null)
      [ "${active:-0}" = "1" ] || break
      sleep 2
    done
    just _bench_finish "_probe-d" "v4-flash-replicas" "$((32 * n))" "0" "probe" "probe" >/dev/null 2>&1 || true
    rm -f metrics/_probe-d.json
    echo "  mean GPU utilisation while the fleet was under load:"
    means=""
    for p in $pods; do
      read -r sum cnt < "/tmp/.probe-$p"; rm -f "/tmp/.probe-$p"
      m=$(( cnt > 0 ? sum / cnt : 0 ))
      printf "    %-44s %3d%%\n" "$p" "$m"
      means="$means $m"
    done
    # awk, not python: multi-line python in a recipe puts continuation lines at column 0 and
    # just tokenises them as recipe syntax.
    echo "$means" | awk '{ lo=1e18; hi=0; n=0;
        for (i=1;i<=NF;i++) { v=$i+0; n++; if (v<lo) lo=v; if (v>hi) hi=v }
        if (n<2) exit
        if (lo<5) print "  VERDICT: a replica sat idle under load — the aggregate is one engine, not the fleet"
        else if (hi/lo>=1.5) printf "  VERDICT: replicas differ %.2fx in utilisation — warm them and measure again\n", hi/lo
        else printf "  VERDICT: both replicas busy, within %.2fx — the fleet aggregate is believable\n", hi/lo }'

# Readiness, then measure, then write. The only entry point bench-a/b/c/d use.
_bench name label claim svc concurrency:
    #!/usr/bin/env bash
    set -uo pipefail
    just wait-ready 8099 "{{svc}}" || exit 1
    just _bench_start "{{name}}" "{{label}}" "{{claim}}" "{{svc}}" "{{concurrency}}" "3" "256"
    just _bench_finish "{{name}}" "{{svc}}" "{{concurrency}}" "3" "{{label}}" "{{claim}}"

# Launch the bench Job and return immediately, so callers can poll it.
_bench_start name label claim svc concurrency runs max_tokens="256":
    #!/usr/bin/env bash
    set -uo pipefail
    # INVARIANT 7: one bench at a time, and a second one must SHOUT rather than take over.
    # This unconditionally deleted any existing Job and replaced it, so two concurrent runs
    # silently fought over the name and the loser's result was written under the winner's
    # label. That happened twice: two `bench-d` invocations at once, and later a stale
    # verification script firing `bench-b` while a re-measure sequence had already moved on to
    # B-without-DSpark -- which would have recorded B-nospec's throughput as B's, the exact
    # number the talk's headline rests on. Refuse instead.
    active=$(kubectl -n {{ns}} get job bench-in-cluster -o jsonpath='{.status.active}' 2>/dev/null || true)
    if [ "${active:-0}" -ge 1 ] 2>/dev/null; then
      echo "REFUSING: a bench Job is already running in {{ns}}. Two concurrent benches"
      echo "contaminate each other and write under each other's labels. Wait for it, or:"
      echo "    kubectl -n {{ns}} delete job bench-in-cluster"
      exit 1
    fi
    # WAIT for the old Job to be GONE, do not sleep and hope. A Job takes longer than a few
    # seconds to disappear, and `kubectl apply` against a still-terminating Job with a different
    # spec does NOT replace it — so the previous run's Job survives and _job-wait then reports
    # ITS outcome. That happened: a stale bench-d Job left over from a killed sequence made the
    # B-without-DSpark leg report a DNS failure against v4-flash-replicas, a Service that
    # belonged to a different strategy entirely. The concurrency guard above only catches
    # ACTIVE Jobs; this catches stale ones.
    kubectl -n {{ns}} delete job bench-in-cluster --ignore-not-found >/dev/null 2>&1
    for i in $(seq 1 40); do
      kubectl -n {{ns}} get job bench-in-cluster >/dev/null 2>&1 || break
      [ "$i" = "40" ] && { echo "FATAL: previous bench Job will not go away"; exit 1; }
      sleep 3
    done
    kubectl -n {{ns}} create configmap bench-src --from-file=bench.py=bench.py \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
    sed -e "s|__NS__|{{ns}}|g" -e "s|__NAME__|{{name}}|g" -e "s|__SVC__|{{svc}}|g" \
        -e "s|__LABEL__|{{label}}|g" -e "s|__CLAIM__|{{claim}}|g" \
        -e "s|__RUNS__|{{runs}}|g" -e "s|__CONCURRENCY__|{{concurrency}}|g" \
        -e "s|__MAX_TOKENS__|{{max_tokens}}|g" \
        bench-job.yaml.tmpl | kubectl apply -f - >/dev/null
    echo "bench Job started: svc/{{svc}} concurrency {{concurrency}} runs {{runs}} max_tokens {{max_tokens}}"

# INVARIANT 3: block until one of three outcomes, and say which. `kubectl wait
# --for=condition=complete` never matches a Failed Job, and backoffLimit is 0.
_job-wait job cycles="240":
    #!/usr/bin/env bash
    set -uo pipefail
    for i in $(seq 1 {{cycles}}); do
      st=$(kubectl -n {{ns}} get job {{job}} -o jsonpath='{.status.conditions[*].type}' 2>/dev/null)
      case "$st" in
        *Complete*) echo "{{job}}: Complete"; exit 0;;
        *Failed*)   echo "{{job}}: FAILED"; kubectl -n {{ns}} logs job/{{job}} --tail=25; exit 1;;
      esac
      sleep 10
    done
    echo "{{job}}: reached neither Complete nor Failed in $(( {{cycles}} * 10 ))s"
    kubectl -n {{ns}} get job {{job}} -o wide
    kubectl -n {{ns}} logs job/{{job}} --tail=25
    exit 1

# INVARIANT 4: only a real Complete produces a metrics file.
_bench_finish name svc concurrency runs="3" label="" claim="":
    #!/usr/bin/env bash
    set -uo pipefail
    just _job-wait bench-in-cluster || { echo "not writing metrics/{{name}}.json"; exit 1; }
    # The sanity verdict is printed BEFORE the timings, so `tail -5` hid the one line that
    # says whether the timings mean anything. Surface it explicitly.
    kubectl -n {{ns}} logs job/bench-in-cluster | grep -E '^sanity:|OUTPUT IS NOT SANE' || true
    kubectl -n {{ns}} logs job/bench-in-cluster | tail -5
    kv=$(just _kv-tokens "{{name}}")
    mkdir -p metrics
    kubectl -n {{ns}} logs job/bench-in-cluster \
      | python3 incluster_to_json.py "{{name}}" "{{svc}}" "{{concurrency}}" "{{runs}}" \
          "${kv:-0}" "{{label}}" "{{claim}}"

# KV cache capacity the engine logged, for the ONE strategy named. It takes the name rather than
# guessing, because a wrong guess here does not fail — it silently reports another strategy's
# number in this strategy's row, and the KV column exists precisely to discriminate between them
# (A 5.5M · B 5.0M are different engines, not different runs of one).
#
# Each RayService owns its own RayCluster, so the engine's log is in THAT cluster's worker pod
# under /tmp/ray/session_latest/logs. There is no shared head whose log directory accumulates
# every strategy's output.
#
# For D this reports ONE replica's cache, not the fleet's: both replicas are the same engine with
# the same window, so the per-replica figure is the comparable one (it should equal A's, since D
# is A replicated). The fleet holds twice it.
_kv-tokens name:
    #!/usr/bin/env bash
    set -uo pipefail
    case "{{name}}" in
      A-tep8*)          svc=v4-flash-a ;;
      B-dp8-ep-nospec*) svc=v4-flash-b-nospec ;;
      B-dp8-ep*)        svc=v4-flash-b ;;
      D-replicas*)      svc=v4-flash-d ;;
      1M*|longctx*)     svc=v4-flash-1m ;;
      *)                svc="" ;;
    esac
    if [ -n "$svc" ]; then
      w=$(kubectl -n {{ns}} get pods --no-headers 2>/dev/null \
          | awk -v p="^${svc}-[a-z0-9]+-gpu8-worker" '$1 ~ p && $3=="Running" {print $1}' | head -1)
      if [ -n "${w:-}" ]; then
        # BOTH .out and .err: Ray splits an actor's streams into separate files and this line
        # arrives on stdout, so globbing only .err silently yields nothing and the KV column
        # reads "0" for an engine that logged it perfectly well.
        n=$(kubectl -n {{ns}} exec "$w" -- bash -lc \
              'grep -hoE "GPU KV cache size: [0-9,]+" /tmp/ray/session_latest/logs/worker-*.out /tmp/ray/session_latest/logs/worker-*.err 2>/dev/null | tail -1' \
              2>/dev/null | grep -oE '[0-9,]+' | tr -d ,)
        [ -n "${n:-}" ] && { echo "$n"; exit 0; }
      fi
      echo "0"; exit 0        # a RayService strategy must NOT fall through to the replicas
    fi
    p=$(kubectl -n {{ns}} get pod -l app=v4-flash-replica -o name 2>/dev/null | head -1 | cut -d/ -f2)
    if [ -n "${p:-}" ]; then
      n=$(kubectl -n {{ns}} logs "$p" 2>/dev/null | grep -hoE "GPU KV cache size: [0-9,]+ tokens" | tail -1 | grep -oE '[0-9,]+' | tr -d ,)
      [ -n "${n:-}" ] && { echo "$n"; exit 0; }
    fi
    echo 0

# --- stage setup (what you run BEFORE the talk) -----------------------------
# The demo cannot start an engine: measured cold starts run to tens of minutes, longer than the
# whole slot. Bring the engines up ahead of time and leave them running.
#
# GPU budget on 3x 8 B200 = 24: A takes 8, B takes 8, the 1M engine takes 8. Strategy D wants 16
# on its own, so it cannot share with them — its story is a number, and `just compare` reads
# numbers from metrics/*.json with nothing running.

# Bring up the demo configuration: A, B and the 1M engine together, then warm everything.
[doc("Bring up the demo-day configuration and warm it")]
stage-up:
    #!/usr/bin/env bash
    set -uo pipefail
    just teardown
    echo "=== A (TP8 + EP), B (DP8 x EP + DSpark), 1M window — 8 GPUs each, all 24 in use ==="
    kubectl apply -f 11-strategy-tep8-rayservice.yaml \
                  -f 21-strategy-dp8-ep-rayservice.yaml \
                  -f 51-longctx-1m-rayservice.yaml
    echo "applied; the three engines load in parallel (this is the time you move off stage)"
    # Each wait must be FATAL. An engine that is not Ready is absent from its Service's
    # endpoints, so warming skips it and the measurement that follows catches it cold: an
    # unwarmed engine reports a small fraction of a warm one's throughput and still looks like
    # a real result.
    rc=0
    for s in a b 1m; do
      kubectl -n {{ns}} wait --for=condition=Ready "rayservice/v4-flash-${s}" --timeout=45m || {
        echo "FATAL: v4-flash-${s} did not become Ready. Not warming, not measuring."
        kubectl -n {{ns}} get rayservice "v4-flash-${s}"
        rc=1; }
    done
    [ "$rc" -eq 0 ] || exit 1
    just warm
    just state

# Tear the stage configuration down.
[doc("Tear the demo configuration back down")]
stage-down: teardown-cluster
    @echo "stage torn down"

# Readiness is not warmth. A health check passes before the engine JIT-compiles kernels for a
# request shape, so a Ready engine can still queue tens of seconds behind compilation the first
# time it generates — enough to make a warm engine's throughput look like a fraction of itself.
# Run after stage-up, and again whenever anything restarts.
[doc("Make every live endpoint generate once, at the measured shape")]
warm:
    #!/usr/bin/env bash
    set -uo pipefail
    # Reuses the in-cluster bench as the warmer (--runs 0, 64 tokens, at the concurrency
    # each service is measured at — see below). No new code path to get wrong, and no inline
    # python: multi-line python in a recipe puts continuation lines at column 0, where just
    # tokenises them as recipe syntax. Non-trivial python lives in its own file.
    n=$(kubectl -n {{ns}} get pods -l app=v4-flash-replica --field-selector=status.phase=Running -o name 2>/dev/null | grep -c . )
    for svc in v4-flash-tep8 v4-flash-openai v4-flash-longctx v4-flash-replicas; do
      kubectl -n {{ns}} get svc "$svc" >/dev/null 2>&1 || continue
      # Warm at the concurrency that service is MEASURED at: batch size keys CUDA-graph
      # capture and MoE autotune, so warming 16-wide before a 64-wide run misses the shape.
      c=32; [ "$svc" = "v4-flash-replicas" ] && c=$((32 * ${n:-1}))
      echo "warming svc/$svc at concurrency $c — kernels for the shape we will ask for"
      just _bench_start "_warm-$svc" "warmup" "warm the kernels, not just readiness" "$svc" "$c" "0" "64"
      just _bench_finish "_warm-$svc" "$svc" "$c" "0" "warmup" "warm" || echo "  (warm pass on $svc did not finish cleanly)"
      # leading underscore: compare.py skips _-prefixed stems, so an interrupted
      # warm cannot leave a column behind between here and the rm below
      rm -f "metrics/_warm-$svc.json"
    done
    echo "warm: every live endpoint has generated at least once"

# --- the 1M window ------------------------------------------------------------
# Slides 1, 2, 6 and 12 lean on the 1M-token window while A, B and D all serve 262144. These
# recipes make the claim demonstrable. Needs 51-longctx-1m-rayservice.yaml applied, which wants
# a whole machine free.

# Needle-in-a-haystack at the full 1M window, run INSIDE the cluster.
#
# In-cluster, not through a tunnel: a 1M-token prompt is a ~5.8 MB POST body and
# `kubectl port-forward` does not survive it. The tunnel died mid-request, the script saw an
# empty stream, and the following depths all failed "connection refused" — a tooling failure
# that reads exactly like the model rejecting the window. Same reason every bench runs as a Job.
[doc("Needle-in-a-haystack at the full 1M window, run in-cluster")]
longctx tokens="1000000" depth="0.5":
    #!/usr/bin/env bash
    set -uo pipefail
    just _longctx-run "{{tokens}}" "{{depth}}"

# One in-cluster longctx Job, start to finish. Shared by longctx and longctx-sweep so a
# sweep cannot leave a half-finished Job behind for the next iteration to trip over.
_longctx-run tokens depth:
    #!/usr/bin/env bash
    set -uo pipefail
    kubectl -n {{ns}} delete job longctx-in-cluster --ignore-not-found >/dev/null 2>&1
    sleep 2
    kubectl -n {{ns}} create configmap longctx-src --from-file=longctx.py=longctx.py \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
    # A fresh tag per run defeats prefix caching; see longctx.py's build().
    sed -e "s|__NS__|{{ns}}|g" -e "s|__SVC__|v4-flash-longctx|g" \
        -e "s|__TOKENS__|{{tokens}}|g" -e "s|__DEPTH__|{{depth}}|g" \
        -e "s|__TAG__|$(date -u +%H%M%S)-$$|g" \
        longctx-job.yaml.tmpl | kubectl apply -f - >/dev/null
    just _job-wait longctx-in-cluster 1200 || {
      kubectl -n {{ns}} logs job/longctx-in-cluster --tail=8 2>/dev/null; exit 1; }
    # The Job runs only longctx.py, so its whole stdout is ours. An allow-list of lines
    # silently ate the "-> POST / model= / prompt[...]" echo, which exists precisely so the
    # audience can see the request. Show everything instead.
    kubectl -n {{ns}} logs job/longctx-in-cluster 2>/dev/null | sed 's/^/  /'

# The depth sweep is the part that actually tests CSA: a model attending only to the head and
# tail of its window still passes a needle test at depth 0.0 or 1.0.
# TTFT vs context length, plus the needle at five depths through the 1M window.
[doc("TTFT vs context length, plus the needle at five depths through 1M")]
longctx-sweep:
    #!/usr/bin/env bash
    set -uo pipefail
    kubectl -n {{ns}} wait --for=condition=Ready rayservice/v4-flash-1m --timeout=40m || exit 1
    echo "=== what this engine reports about its own cache ==="
    # The engine logs live in the RayService's worker pod, not in a Deployment's log stream.
    w=$(kubectl -n {{ns}} get pods --no-headers 2>/dev/null | awk '/v4-flash-1m.*gpu8-worker/ && $3=="Running"{print $1}' | head -1)
    [ -n "$w" ] && kubectl -n {{ns}} exec "$w" -- bash -lc \
      'grep -hoE "GPU KV cache size: [0-9,]+|Maximum concurrency for [0-9,]+ tokens per request: [0-9.]+x" /tmp/ray/session_latest/logs/worker-*.out /tmp/ray/session_latest/logs/worker-*.err 2>/dev/null | tail -2' \
      2>/dev/null | sed 's/^/  /'
    echo "=== TTFT vs context length (needle at mid-depth) ==="
    for n in 128000 250000 500000 1000000; do
      just _longctx-run "$n" 0.5 | grep -E "POST|prompt\[|prompt_tokens|REJECTED|NO CONTENT|UNREACHABLE" || true
    done
    echo "=== needle depth sweep at 1M — head, middle and tail ==="
    for d in 0.05 0.25 0.5 0.75 0.95; do
      printf "  depth %-5s" "$d"
      just _longctx-run 1000000 "$d" | grep -oE "needle (FOUND|MISSED)|REJECTED|NO CONTENT|UNREACHABLE" | head -1 || echo " no result"
    done

# --- repeatability ----------------------------------------------------------
# One sample is not a measurement. This session produced 424 and 4652 tok/s from the same
# pods minutes apart (cold kernels), and 300 vs 911 from the same manifest under two
# harnesses (chunk- vs token-counting). Repeat, then look at the spread.

# Snapshot ONE strategy's metrics into metrics/_repeat/, tagged with a round label.
# Copying every file made stability.py report a 1.00x spread for strategies that had only
# been measured once — a fake clean bill of health.
_snapshot round stem:
    #!/usr/bin/env bash
    set -uo pipefail
    src="metrics/{{stem}}.json"
    [ -f "$src" ] || { echo "no $src to snapshot"; exit 0; }
    mkdir -p metrics/_repeat
    cp "$src" "metrics/_repeat/{{stem}}__{{round}}.json"
    echo "snapshot: {{stem}}__{{round}}"

# Measurement variance with the engine held constant: bench N times, snapshot each.
[doc("Run one bench N times, snapshotting each result")]
repeat-bench recipe stem rounds="3" tag="r":
    #!/usr/bin/env bash
    set -uo pipefail
    for i in $(seq 1 {{rounds}}); do
      echo "=== {{recipe}} pass $i/{{rounds}} ==="
      just {{recipe}} || { echo "{{recipe}} pass $i FAILED"; continue; }
      just _snapshot "{{tag}}$i" "{{stem}}"
    done

# Full tour repeated N times (~1.5 h/round): engine-to-engine + measurement variance.
[doc("Run the whole tour N times for a stability read")]
repeat-tour rounds="2":
    #!/usr/bin/env bash
    set -uo pipefail
    for r in $(seq 1 {{rounds}}); do
      echo; echo "################ ROUND $r/{{rounds}} ################"
      just run-a        && just repeat-bench bench-a        A-tep8           2 "r${r}" || echo "A failed in round $r"
      just run-b        && just repeat-bench bench-b        B-dp8-ep         2 "r${r}" || echo "B failed in round $r"
      just run-b-nospec && just repeat-bench bench-b-nospec B-dp8-ep-nospec  2 "r${r}" || echo "B-nospec failed in round $r"
      just run-d        && just repeat-bench bench-d        D-replicas       2 "r${r}" || echo "D failed in round $r"
      just stability
    done

# Median / min / max / spread across every repeat — flags anything above 1.5x.
# Demo beat 4's evidence. Strategy C is NOT running during the demo -- this prints the
# artifact the harness wrote when C WAS measured, which is the whole point: the file records a
# throughput number next to a verdict that the number is worthless.
# A recipe rather than a `grep metrics/C-pd.json` in the runbook, because every other demo
# command is `just something`, and the single bare relative path is exactly the one that breaks
# when you are standing one directory up.
# No heredoc: a `<<'PY'` terminator has to sit at column 0, which collides with just's rule
# that every recipe line is indented. One python -c, one print.
[doc("Beat 4: print the recorded proof that C was fast and wrong")]
receipt:
    #!/usr/bin/env bash
    set -uo pipefail
    f="{{ justfile_directory() }}/metrics/C-pd.json"
    [ -f "$f" ] || { echo "no C measurement on disk at $f"; exit 1; }
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); u=d["under_load"]; print("\n  " + d.get("label","C · P/D 4+4") + "  (recorded — C is NOT running)\n  " + "-"*68 + "\n  aggregate throughput   " + str(u["aggregate_output_tok_s"]) + " tok/s\n  failed requests        " + str(u.get("failed",0)) + "\n  concurrency            " + str(u.get("concurrency")) + "\n  output_sane            " + str(d["output_sane"]) + "   <-- the gate\x27s verdict\n  it was asked           \"What is 2+2? Reply with only the number.\"\n  it answered            " + repr(d["sanity_answer"][:110]) + "\n\n  Fast, zero errors, HTTP 200 every time, and wrong. Throughput cannot report\n  incorrectness — so `just compare` prints this column as ✗, not as numbers.\n")' "$f"

# tag names the measurement campaign to read (the suffix repeat-bench was given). Without it,
# claims.py refuses whenever metrics/_repeat holds more than one, rather than taking a median
# across architectures.
[doc("Derive every deck/abstract claim from the measurements, with provenance")]
claims tag="rayservice":
    @python3 claims.py --tag {{tag}}

[doc("Median and spread across repeat runs — is a number a measurement yet?")]
stability:
    @python3 stability.py metrics/_repeat

# --- comparison -------------------------------------------------------------

# Every strategy side by side, each next to the point it is meant to make.
#
# tag names the measurement campaign, exactly as in `just claims`. Without it compare.py would
# median across every campaign in metrics/_repeat, which mixes architectures — and this is the
# table shown on stage, so it has to describe one system.
[doc("Every strategy side by side, each next to the point it makes")]
compare tag="rayservice":
    @python3 compare.py --tag {{tag}} metrics

# Wipe the current measurements. Keeps _archive-* runs: those are the evidence behind several
# README and speaker-prep claims, so they are archived rather than deleted.
[doc("Archive metrics/*.json rather than deleting them")]
clean-metrics:
    -@rm -f metrics/[A-Z]*.json
    @echo "current metrics cleared; archives kept:"; ls metrics/_archive-* 2>/dev/null | wc -l
